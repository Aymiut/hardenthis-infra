# terraform.tfvars.example
# Copy to terraform.tfvars and fill in real values (never commit terraform.tfvars)

aws_region     = "us-east-1"
aws_account_id = "123456789012"
environment    = "prod"
project_name   = "defendarcade"

# DNS (Cloudflare handles DNS, no Route53)
domain_name = "hardenthis.com"

# ECR images (pushed by GitLab CI — update tag per deploy)
ecr_backend_image   = "123456789012.dkr.ecr.us-east-1.amazonaws.com/defendarcade/backend:latest"
ecr_frontend_image  = "123456789012.dkr.ecr.us-east-1.amazonaws.com/defendarcade/frontend:latest"

# Database
db_username = "defendarcade"
db_password = "CHANGE_ME_strong_password_here"
db_name     = "defendarcade"

# Secrets (use a password manager to generate these)
jwt_access_secret  = "CHANGE_ME_jwt_access_secret_min_32_chars"
jwt_refresh_secret = "CHANGE_ME_jwt_refresh_secret_min_32_chars"
admin_sync_secret  = "CHANGE_ME_admin_sync_secret_for_cicd"
terminal_secret    = "CHANGE_ME_terminal_secret_min_32_chars"
redis_auth_token   = "CHANGE_ME_redis_auth_token_min_16_chars"

# Traefik
traefik_instance_type = "t3.small"
