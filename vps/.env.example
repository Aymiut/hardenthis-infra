# ============================================================
# Production environment for VPS deployment
# Copy to .env on the VPS and fill in real values.
# DO NOT COMMIT THE REAL .env FILE.
# ============================================================

# --- Domain ---
DOMAIN_NAME=hardenthis.com
ACME_EMAIL=admin@hardenthis.com
VPS_PUBLIC_IP=203.0.113.42  # IPv4 fixe du VPS — utilisée par le SSRF guard
FRONTEND_URL=https://hardenthis.com  # CORS allow-list (séparer plusieurs origines par virgule)

# --- Images (registry/tag) — GitLab Container Registry ---
# Format : registry.gitlab.com/<group>/<project>:latest
BACKEND_IMAGE=registry.gitlab.com/CHANGE_ME/backend:latest
FRONTEND_IMAGE=registry.gitlab.com/CHANGE_ME/frontend:latest

# --- Postgres (interne, jamais exposé en dehors du réseau Docker) ---
POSTGRES_USER=hardenthis
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_32
POSTGRES_DB=hardenthis

# --- JWT secrets (openssl rand -base64 32) ---
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- Admin / terminal ---
ADMIN_SYNC_SECRET=CHANGE_ME
TERMINAL_SECRET=CHANGE_ME

# --- Labs limits ---
LAB_MAX_DURATION_HOURS=2
MAX_ACTIVE_LABS_PER_USER=1

# --- AWS — labs only ---
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
ECR_REGISTRY=123456789012.dkr.ecr.eu-west-3.amazonaws.com
ECS_CLUSTER_NAME=hardenthis-labs-cluster
ECS_SUBNET_ID=subnet-xxxxxx
ECS_SECURITY_GROUP_ID=sg-xxxxxx
ECS_TASK_ROLE_ARN=arn:aws:iam::123456789012:role/lab-task-role
ECS_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/lab-execution-role
LABS_LOG_GROUP=/ecs/hardenthis-labs

# --- Labs EC2 runtime (labs needing systemctl, iptables, kernel features) ---
# Reuses the ECS subnet + SG (same ports 7681/9999, ingress restricted to VPS IP).
LAB_EC2_SUBNET_ID=subnet-xxxxxx
LAB_EC2_SECURITY_GROUP_ID=sg-xxxxxx
LAB_EC2_INSTANCE_PROFILE_ARN=arn:aws:iam::123456789012:instance-profile/hardenthis-prod-lab-ec2
LAB_EC2_INSTANCE_TYPE=t3.micro

# --- S3 uploads (peut rester sur AWS, ou migrer vers Backblaze B2) ---
S3_ASSETS_BUCKET=hardenthis-prod-assets
CDN_URL=https://hardenthis-prod-assets.s3.eu-west-3.amazonaws.com

# --- Traefik ---
TRAEFIK_LOG_LEVEL=INFO
